<?xml version='1.0' encoding='utf-8'?>
<widget id="com.jasdifix.electroscanpro" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>ElectroScan Pro</name>
    <description>Aplikasi Imbasan dan Diagnosis Elektronik</description>
    <author email="admin@jasdifix.com" href="https://github.com/jasmkt">
        JAS DIFIX
    </author>
    <content src="index.html" />
    
    <!-- Kebenaran sambungan penuh ke pelayan API luar -->
    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />

    <!-- Tetapan khusus Android supaya sambungan API tidak disekat -->
    <platform name="android">
        <preference name="AndroidInsecureFileModeEnabled" value="true" />
        <preference name="MixedContentMode" value="0" />
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:usesCleartextTraffic="true" />
        </edit-config>
        <!-- Ikon aplikasi (pastikan fail www/icon.png dimuat naik jika mahu tukar ikon) -->
        <!-- <icon src="www/icon.png" /> -->
    </platform>
</widget>
